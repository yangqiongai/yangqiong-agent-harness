<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yangqiongai.agent</groupId>
        <artifactId>yangqiong-agent-harness</artifactId>
        <version>1.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>yangqiong-agent-examples</artifactId>
    <packaging>pom</packaging>

    <name>yangqiong-agent-examples</name>
    <description>泱穹智能体框架示例聚合</description>

    <properties>
        <!-- 示例模块仅作本地演示与编译校验，不随发布入库（deploy 与 central-publishing 均识别该属性） -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>yangqiong-agent-example-hello-world</module>
        <module>yangqiong-agent-example-spring-boot</module>
        <module>yangqiong-agent-example-multi-agent</module>
        <module>yangqiong-agent-example-local</module>
        <module>yangqiong-agent-example-server</module>
        <module>yangqiong-agent-example-eval</module>
        <module>yangqiong-agent-example-observability</module>
        <module>yangqiong-agent-example-paradigms</module>
        <module>yangqiong-agent-example-features</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 运行纯 Java 示例：mvn -pl <模块> exec:java -Dexec.mainClass=... -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <!-- 运行 Spring Boot 示例：mvn -pl <模块> spring-boot:run -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
