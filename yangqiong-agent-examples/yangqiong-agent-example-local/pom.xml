<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yangqiongai.agent</groupId>
        <artifactId>yangqiong-agent-examples</artifactId>
        <version>1.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>yangqiong-agent-example-local</artifactId>
    <packaging>jar</packaging>

    <name>yangqiong-agent-example-local</name>
    <description>泱穹智能体框架本地模式示例：本地模型发现 + SQLite存储 + 工作区 + Shell工具 + 检查点续跑（需本机 Ollama/LM Studio）</description>

    <dependencies>
        <dependency>
            <groupId>com.yangqiongai.agent</groupId>
            <artifactId>yangqiong-agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangqiongai.agent</groupId>
            <artifactId>yangqiong-agent-local-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 运行：mvn -pl yangqiong-agent-examples/yangqiong-agent-example-local exec:java -Dexec.mainClass=...LocalModeExample -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
